      "locomotion": { "useWorker": true },
      "grabbing": true,
      "physics": false,
      "sceneUnderstanding": false,
      "spatialUI": true
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "activation": "always",
      "injectOnBuild": true
    }
  }
