<style>
  .panel-container {
    align-items: flex-start;
    background-color: #09090b;
    border-color: #27272a;
    border-radius: 16px;
    border-width: 1px;
    display: flex;
    flex-direction: column;
    padding: 24px;
    width: 480px;
  }

  .heading {
    color: #fafafa;
    font-size: 24px;
    font-weight: 700;
    line-height: 24px;
    text-align: left;
  }

  .settings-entry {
    align-items: flex-start;
    flex-direction: column;
    width: 100%;
  }

  .button-group {
    align-items: center;
    background-color: #27272a;
    border-radius: 12px;
    flex-direction: row;
    gap: 8px;
    justify-content: space-between;
    margin-top: 6px;
    padding: 8px;
    width: 100%;
  }

  .button-group-label {
    color: #fafafa;
    font-size: 14px;
    font-weight: 700;
    line-height: 18px;
    margin-top: 14px;
    text-align: left;
  }

  .button {
    align-items: center;
    background-color: #27272a;
    border-radius: 10px;
    color: #a1a1aa;
    flex-grow: 1;
    font-size: 14px;
    justify-content: center;
    line-height: 18px;
    padding: 10px;
    text-align: center;
  }

  .selected {
    background-color: #09090b;
  }
</style>
<div class="panel-container">
  <div class="heading">Locomotion Settings</div>

  <div id="comfort-assist" class="settings-entry">
    <div class="button-group-label">Comfort Assist</div>
    <div class="button-group">
      <div id="no-assist" class="button">Off</div>
      <div id="standard-assist" class="button selected">Standard</div>
      <div id="high-assist" class="button">High</div>
    </div>
  </div>
  <div id="sliding-speed" class="settings-entry">
    <div class="button-group-label">Sliding Speed</div>
    <div class="button-group">
      <div id="slow-speed" class="button">Slower</div>
      <div id="normal-speed" class="button selected">Normal</div>
      <div id="fast-speed" class="button">Fast</div>
    </div>
  </div>
  <div id="ray-gravity" class="settings-entry">
    <div class="button-group-label">Teleport Range</div>
    <div class="button-group">
      <div id="near-range" class="button">Near</div>
      <div id="normal-range" class="button selected">Normal</div>
      <div id="far-range" class="button">Far</div>
    </div>
  </div>
  <div id="turning-method" class="settings-entry">
    <div class="button-group-label">Turning Method</div>
    <div class="button-group">
      <div id="snap-turn" class="button selected">Snap Turn</div>
      <div id="smooth-turn" class="button">Smooth Turn</div>
    </div>
  </div>
  <div id="turning-speed" class="settings-entry">
    <div class="button-group-label">Turning Speed</div>
    <div class="button-group">
      <div id="speed-90" class="button">90°/s</div>
      <div id="speed-120" class="button selected">120°/s</div>
      <div id="speed-180" class="button">180°/s</div>
      <div id="speed-360" class="button">360°/s</div>
    </div>
  </div>
  <div id="turning-angle" class="settings-entry">
    <div class="button-group-label">Snap Turn Angle</div>
    <div class="button-group">
      <div id="angle-30" class="button">30°</div>
      <div id="angle-45" class="button selected">45°</div>
      <div id="angle-90" class="button">90°</div>
    </div>
  </div>
</div>
