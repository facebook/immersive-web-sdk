{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/locomotion.iwsdk.scene.json",
  "assets": { "module": "./src/assets" },
  "components": { "module": "./src/components" },
  "world": {
    "xr": {
      "mode": "vr",
      "features": { "handTracking": { "required": true } }
    },
    "render": {
      "near": 0.001,
      "far": 300,
      "camera": {
        "position": [-4, 1.5, -6],
        "rotation": [0, -2.356194490192345, 0]
      }
    },
    "features": {
      "grabbing": true,
      "locomotion": true,
      "spatialUI": true
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "activation": "always",
      "injectOnBuild": true
    }
  }
}
